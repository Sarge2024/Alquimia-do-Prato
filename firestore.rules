rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() 
        && request.auth.token.email == 'sagacitas.sistemas@gmail.com' 
        && request.auth.token.email_verified == true;
    }

    // --- Recipe Validation ---
    function isValidRecipe(data) {
      // Use get() to handle missing fields during partial updates
      return (data.get('title', 'placeholder') is string && data.get('title', 'placeholder').size() <= 500)
        && (data.get('category', 'Almoço') in ['Café da Manhã', 'Almoço', 'Jantar', 'Sobremesas', 'Bebidas', 'Cocktail'])
        && (data.get('ingredients', []) is list && data.get('ingredients', []).size() <= 200)
        && (data.get('instructions', []) is list && data.get('instructions', []).size() <= 200)
        && (data.get('image', null) == null || (data.get('image', '') is string && data.get('image', '').size() <= 8000))
        && (data.get('servings', null) == null || (data.get('servings', '') is string && data.get('servings', '').size() <= 512))
        && (data.get('difficulty', 'Médio') in ['Fácil', 'Médio', 'Avançado'])
        && (data.get('time', null) == null || (data.get('time', '') is string && data.get('time', '').size() <= 256))
        && (data.get('prepTime', null) == null || (data.get('prepTime', '') is string && data.get('prepTime', '').size() <= 256))
        && (data.get('dietType', 'Convencional') in ['Convencional', 'Vegana', 'Vegetariana', 'Low Carb', 'Keto', 'Sem Glúten', 'Fit'])
        && (data.get('description', null) == null || (data.get('description', '') is string && data.get('description', '').size() <= 10000))
        && (data.get('rating', 0) is number)
        && (data.get('reviewsCount', 0) is number);
    }

    // --- Collections ---
    match /test/connection {
      allow read: if true;
    }

    match /recipes/{recipeId} {
      allow read: if true; // Publicly readable
      
      allow create: if isSignedIn() 
        && isValidId(recipeId) 
        && incoming().keys().hasAll(['title', 'category', 'ingredients', 'instructions', 'ownerId', 'createdAt', 'updatedAt', 'rating', 'reviewsCount'])
        && isValidRecipe(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (isOwner(existing().ownerId) || isAdmin())
        && isValidRecipe(incoming())
        && incoming().get('ownerId', existing().ownerId) == existing().ownerId
        && (incoming().get('ownerId', request.auth.uid) == request.auth.uid || isAdmin())
        && incoming().get('createdAt', existing().createdAt) == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Full Edit Action
          incoming().diff(existing()).affectedKeys().hasAny(['title', 'description', 'image', 'category', 'time', 'prepTime', 'dietType', 'servings', 'difficulty', 'ingredients', 'instructions', 'updatedAt', 'rating', 'reviewsCount'])
        );

      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }
  }
}
