rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Recipe Validation ---
    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'category', 'ingredients', 'instructions', 'ownerId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 100
        && data.category in ['Café da Manhã', 'Almoço', 'Jantar', 'Sobremesas', 'Bebidas']
        && data.ingredients is list && data.ingredients.size() <= 50
        && data.instructions is list && data.instructions.size() <= 50
        && data.ownerId == request.auth.uid
        && (data.image == null || (data.image is string && data.image.size() <= 2048))
        && (data.servings == null || (data.servings is string && data.servings.size() <= 64))
        && (data.difficulty == null || data.difficulty in ['Fácil', 'Médio', 'Avançado'])
        && (data.time == null || (data.time is string && data.time.size() <= 64))
        && (data.description == null || (data.description is string && data.description.size() <= 1000));
    }

    // --- Collections ---
    match /recipes/{recipeId} {
      allow read: if true; // Publicly readable
      
      allow create: if isSignedIn() 
        && isValidId(recipeId) 
        && isValidRecipe(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(existing().ownerId)
        && isValidRecipe(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Full Edit Action
          incoming().diff(existing()).affectedKeys().hasAny(['title', 'description', 'image', 'category', 'time', 'servings', 'difficulty', 'ingredients', 'instructions', 'updatedAt'])
        );

      allow delete: if isOwner(existing().ownerId);
    }
  }
}
