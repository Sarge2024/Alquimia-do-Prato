rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sagacitas.sistemas@gmail.com';
    }

    // --- Recipe Validation ---
    function isValidRecipe(data) {
      return (data.get('title', 'valid') is string && data.get('title', 'valid').size() <= 1000)
        && (data.get('difficulty', 'Médio') in ['Fácil', 'Médio', 'Difícil'])
        && (data.get('custo_estimado', '$$') in ['$', '$$', '$$$', '$$$$'])
        && (data.get('dietType', 'Convencional') in ['Convencional', 'Vegana', 'Vegetariana', 'Low Carb', 'Keto', 'Sem Glúten', 'Fit']);
    }

    // --- Collections ---
    match /test/connection {
      allow read: if true;
    }

    match /recipes/{recipeId} {
      allow read: if true; // Publicly readable
      
      allow create: if isSignedIn() 
        && isValidId(recipeId) 
        && incoming().keys().hasAll(['title', 'momento', 'tipo_prato', 'base_alimento', 'ingredients', 'instructions', 'ownerId', 'createdAt', 'updatedAt', 'rating', 'reviewsCount'])
        && isValidRecipe(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (isOwner(existing().ownerId) || isAdmin())
        && isValidRecipe(incoming())
        && (incoming().get('ownerId', existing().ownerId) == existing().ownerId || isAdmin())
        && incoming().get('createdAt', existing().createdAt) == existing().createdAt
        && (incoming().updatedAt == request.time || isAdmin());

      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }
  }
}
