rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'sagacitas.sistemas@gmail.com';
    }

    // --- Recipe Validation ---
    function isValidRecipe(data) {
      return (data.title is string && data.title.size() <= 300)
        && (data.difficulty in ['Fácil', 'Médio', 'Difícil'])
        && (data.custo_estimado in ['$', '$$', '$$$', '$$$$'])
        && (data.dietType in ['Convencional', 'Vegana', 'Vegetariana', 'Low Carb', 'Keto', 'Sem Glúten', 'Fit'])
        && (data.ingredients is list && data.ingredients.size() <= 100)
        && (data.instructions is list && data.instructions.size() <= 50)
        && (data.rating is number && data.rating >= 0 && data.rating <= 5)
        && (data.reviewsCount is number && data.reviewsCount >= 0);
    }

    // --- Collections ---
    match /test/connection {
      allow read: if true;
    }

    match /recipes/{recipeId} {
      allow read: if true; // Publicly readable
      
      allow create: if isVerified() 
        && isValidId(recipeId) 
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().rating == 4.5 // Baseline
        && incoming().reviewsCount == 0
        && isValidRecipe(incoming());

      allow update: if (isVerified() && isValidRecipe(incoming())) && (
        isAdmin() || (
          isOwner(existing().ownerId) && 
          // Action: Edit content - Prevents tampering with ownership, rating, or timestamps
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'momento', 'tipo_prato', 'base_alimento', 'origem', 'ingredients', 'instructions', 'image', 'imageOptions', 'time', 'prepTime', 'servings', 'difficulty', 'dietType', 'updatedAt']) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time
        )
      );

      allow delete: if isAdmin() || (isVerified() && isOwner(existing().ownerId));
    }
  }
}
